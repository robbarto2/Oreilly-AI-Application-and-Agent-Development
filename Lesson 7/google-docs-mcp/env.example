# Copy to .env and fill in (never commit .env).
# Option A — service account: download JSON from GCP, point to it, share each Doc with the SA email.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Option B — user OAuth (run: npm run oauth-setup after npm run build)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
